# Copy to .env for docker compose (docker compose reads it automatically),
# or pass these with `docker run -e ...`.

# --- required for stable sessions -------------------------------------------
# Without this, Trackete generates a random secret at startup and everyone is
# signed out when the container restarts.
JWT_SECRET=replace-with-a-long-random-string

# --- optional ---------------------------------------------------------------
PORT=8080
DB_PATH=/data/trackete.db
ALLOW_REGISTRATION=true
TOKEN_TTL=720h
# Only set STATIC_DIR when running the binary outside the Docker image.
# STATIC_DIR=./frontend/dist
# Extra origins allowed to call the API with cookies (development only,
# comma separated). Same-origin deployments do not need it.
# CORS_ORIGINS=http://localhost:5173
APP_VERSION=dev
