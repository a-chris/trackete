# Copy to .env for docker compose (docker compose reads it automatically),
# or pass these with `docker run -e ...`.

# --- session secret ---------------------------------------------------------
# Optional. When empty, Trackete generates a random secret on first run and
# stores it in .jwt-secret next to the database (inside the /data volume), so
# sessions survive restarts. Set it to pin the value yourself
# (`openssl rand -hex 32`); delete .jwt-secret to rotate.
# If the secret cannot be written, startup fails instead of silently signing
# everyone out on the next restart.
JWT_SECRET=
# Path of the generated secret file. Defaults to .jwt-secret in the DB folder.
# JWT_SECRET_FILE=/data/.jwt-secret

# --- optional ---------------------------------------------------------------
PORT=8080
DB_PATH=/data/trackete.db
ALLOW_REGISTRATION=true
TOKEN_TTL=720h
# Comma-separated IPs/CIDRs of reverse proxies whose X-Forwarded-For header is
# trusted. Empty means trust no proxy, so every client is identified by its
# socket address. Behind a reverse proxy you must list the proxy network (e.g.
# 172.16.0.0/12), otherwise per-IP rate limiting sees only the proxy's address.
# TRUSTED_PROXIES=172.16.0.0/12
# Only set STATIC_DIR when running the binary outside the Docker image.
# STATIC_DIR=./frontend/dist
# Extra origins allowed to call the API with cookies (development only,
# comma separated). Same-origin deployments do not need it. A "*" entry is
# ignored: cookies are sent with credentials, so list origins explicitly.
# CORS_ORIGINS=http://localhost:5173
APP_VERSION=dev

# --- sharing invitations ----------------------------------------------------
# Origin used in invitation links. Set this to the address people actually open,
# otherwise the links in invitation emails point at the wrong host.
APP_URL=http://localhost:8080
# How invitation emails leave the process: smtp | file | log.
# Empty means: smtp when SMTP_HOST is set, otherwise file.
#   smtp  send through SMTP_HOST (STARTTLS is used when the server offers it)
#   file  append each message, links included, to MAIL_FILE_PATH
#   log   print each message to the container log
MAIL_TRANSPORT=
SMTP_HOST=
SMTP_PORT=587
# Credentials for SMTP AUTH. Leave empty for servers that accept mail without it.
SMTP_USERNAME=
SMTP_PASSWORD=
# Sender address. Most providers require it to be a verified sender.
MAIL_FROM=Trackete <no-reply@trackete.local>
# Outbox for the file transport. Defaults to outbox.log next to DB_PATH, so it
# lands in the /data volume and survives restarts. Grep it for /invite/ links
# when no SMTP server is configured.
# MAIL_FILE_PATH=/data/outbox.log
