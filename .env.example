# Copy to .env for docker compose (docker compose reads it automatically),
# or pass these with `docker run -e ...`.

# --- session secret ---------------------------------------------------------
# Optional. When empty, Trackete generates a random secret on first run and
# stores it in .jwt-secret next to the database (inside the /data volume), so
# sessions survive restarts. Set it to pin the value yourself
# (`openssl rand -hex 32`); delete .jwt-secret to rotate.
# If the secret cannot be written, startup fails instead of silently signing
# everyone out on the next restart.
JWT_SECRET=
# Path of the generated secret file. Defaults to .jwt-secret in the DB folder.
# JWT_SECRET_FILE=/data/.jwt-secret

# --- optional ---------------------------------------------------------------
PORT=8080
DB_PATH=/data/trackete.db
ALLOW_REGISTRATION=true
TOKEN_TTL=720h
# Comma-separated IPs/CIDRs of reverse proxies whose X-Forwarded-For header is
# trusted. Unset means loopback plus the private ranges (the Rails list), which
# already covers Docker's bridge gateway and a proxy on the same host: behind a
# reverse proxy you normally set nothing. Override it to narrow the trust, or
# set `none` to trust no proxy, so every client is identified by its socket
# address (forwarded client IPs are then ignored and per-IP login throttling
# keys on the proxy).
# TRUSTED_PROXIES=172.28.0.0/24
# TRUSTED_PROXIES=none
# Only set STATIC_DIR when running the binary outside the Docker image.
# STATIC_DIR=./frontend/dist
# Extra origins allowed to call the API with cookies (development only,
# comma separated). Same-origin deployments do not need it. A "*" entry is
# ignored: cookies are sent with credentials, so list origins explicitly.
# CORS_ORIGINS=http://localhost:5173
APP_VERSION=dev
